# Required: Gemini API key.
GEMINI_API_KEY=your_api_key

# Optional: override the chat model. Default models/gemini-2.5-flash-lite.
# SHL_CHAT_MODEL=models/gemini-2.5-flash-lite

# Optional: override the embedding model. Default models/gemini-embedding-001.
# SHL_EMBED_MODEL=models/gemini-embedding-001
